{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch Simulador",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/simulador",
            "args": ["-c", "test/teste1.txt"],            
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build com Makefile",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}